<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Etapix" Manufacturer="Pontesrrafael / Etapix" Version="$(var.Version)" UpgradeCode="231CB751-6597-4D24-BE95-3C11905154BF" Scope="perUser" InstallerVersion="500" Language="1046">
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do Etapix MSI já está instalada." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPCOMMENTS" Value="MSI por usuário; não altera automaticamente configurações de assistentes. Instalação separada do instalador EXE legado." />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolderEtapix" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Etapix-MSI">
          <Component Id="Application" Guid="0C45171A-93A9-43B8-AD73-1D63822CBA88">
            <File Id="EtapixExe" Source="$(var.Payload)/etapix.exe" />
            <RegistryValue Root="HKCU" Key="Software\Etapix\MSI" Name="Application" Value="1" Type="integer" KeyPath="yes" />
          </Component>
          <Component Id="Connector" Guid="30E62E75-98EF-4D1B-A754-4962BFCE7BC9">
            <File Source="$(var.Payload)/etapix-mcp.exe" />
            <RegistryValue Root="HKCU" Key="Software\Etapix\MSI" Name="Connector" Value="1" Type="integer" KeyPath="yes" />
          </Component>
          <Component Id="Notices" Guid="678512BD-A9C7-4476-8745-A1BBD8942734">
            <File Source="$(var.Payload)/LICENSE-MIT.txt" />
            <File Source="$(var.Payload)/LICENSE-APACHE.txt" />
            <File Source="$(var.Payload)/THIRD-PARTY-NOTICES.txt" />
            <File Source="$(var.Payload)/LEIA-ME-MSI.txt" />
            <RegistryValue Root="HKCU" Key="Software\Etapix\MSI" Name="Notices" Value="1" Type="integer" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="EtapixMenu" Name="Etapix MSI">
        <Component Id="StartMenu" Guid="246C1163-9383-4D58-AEE2-FDA1822FD38B">
          <Shortcut Id="EtapixShortcut" Name="Etapix" Target="[#EtapixExe]" WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Etapix\MSI" Name="StartMenu" Value="1" Type="integer" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main" Title="Etapix" Level="1">
      <ComponentRef Id="Application" /><ComponentRef Id="Connector" /><ComponentRef Id="Notices" /><ComponentRef Id="StartMenu" />
    </Feature>
  </Package>
</Wix>
